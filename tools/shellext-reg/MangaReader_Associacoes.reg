Windows Registry Editor Version 5.00

; ============================================================
; MangaReader — associação de arquivos + ícones de miniatura
; no Windows Explorer (abordagem leve, sem Shell Extension COM).
;
; Antes de importar, ajuste os caminhos abaixo para onde o
; MangaReader.exe e os .ico estiverem instalados.
; ============================================================

[HKEY_CLASSES_ROOT\MangaReader.File]
@="Arquivo de Quadrinhos"
"FriendlyTypeName"="Quadrinhos / Mangá"
"DefaultIcon"="C:\\Program Files\\MangaReader\\MangaReader.exe,0"

[HKEY_CLASSES_ROOT\MangaReader.File\shell]
@="open"

[HKEY_CLASSES_ROOT\MangaReader.File\shell\open]
"MUIVerb"="Abrir com MangaReader"

[HKEY_CLASSES_ROOT\MangaReader.File\shell\open\command]
@="\"C:\\Program Files\\MangaReader\\MangaReader.exe\" \"%1\""

; ---- Extensões suportadas ----
[HKEY_CLASSES_ROOT\.cbz]
@="MangaReader.File"

[HKEY_CLASSES_ROOT\.cbr]
@="MangaReader.File"

[HKEY_CLASSES_ROOT\.cbt]
@="MangaReader.File"

[HKEY_CLASSES_ROOT\.cb7]
@="MangaReader.File"

; ---- Miniatura grande no painel de detalhes / tooltips do Explorer ----
; O Explorer usa a chave ThumbnailHandler COM para gerar miniaturas reais.
; Para não exigir registro COM, usamos o "OpenWithProgids" + DefaultIcon:
; o Explorer mostrará o ícone da extensão. Para miniaturas REAIS de capa,
; registre a shell extension em tools/shellext-src (ver README).
[HKEY_CLASSES_ROOT\SystemFileAssociations\.cbz\ShellEx]

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.cbz\OpenWithProgids]
"MangaReader.File"=""
