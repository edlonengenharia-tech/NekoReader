<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Requer Windows para WinForms -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI alto definido via Application.SetHighDpiMode no Program.cs; o manifest
         cuida do resto. Manter aqui geraria o warning WFAC010. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);NU1603</NoWarn><!-- pdfium nativo: 2018.4.8.256 resolve no lugar de .204 (mesma DLL) -->
    <AssemblyName>MangaReader</AssemblyName>
    <RootNamespace>MangaReader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ZIP (CBZ), TAR (CBT), RAR (CBR) e 7z (CB7): uma única lib cobre tudo.
         NU1902 (GHSA-6c8g-7p36-r338, DoS em leitura de cabeçalho corrompido): suprimido
         pois o app abre apenas arquivos locais do usuário; remova o NoWarn se preferir. -->
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <!-- Metadados / serialização do estado de leitura -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Copia a pdfium.dll para a pasta da aplicação (build e publish).
       O glob usa o id do pacote em minúsculas, como o NuGet grava na package cache. -->
  <Target Name="CopyPdfiumNative" AfterTargets="Build;Publish">
    <ItemGroup>
      <PdfiumDll Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\**\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="'@(PdfiumDll)' != ''" />
    <Copy SourceFiles="@(PdfiumDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="'@(PdfiumDll)' != '' and '$(PublishDir)' != ''" />
    <Warning Text="pdfium.dll não encontrada em $(NuGetPackageRoot) - rode 'dotnet restore' antes."
             Condition="'@(PdfiumDll)' == ''" />
  </Target>

</Project>
